# ---- Telegram ----
BOT_TOKEN=
OWNER_ID=
CHANNEL_ID=-100
ADMIN_GROUP_ID=-100
BACKUP_CHANNEL_ID=-100

# polling (local dev) | webhook (production)
RUN_MODE=polling

# ---- Web (webhook mode + Verify.et webhook + /healthz) ----
PUBLIC_URL=https://confess.yourdomain.et
# generate: openssl rand -hex 32
WEBHOOK_PATH=/tg/CHANGE_ME_RANDOM_32_HEX
TG_WEBHOOK_SECRET=CHANGE_ME_RANDOM_32_HEX
LISTEN=127.0.0.1:8081

# ---- Crypto (NEVER reuse between deployments) ----
# openssl rand -hex 32
HMAC_SECRET=
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=

# ---- Verify.et ----
VERIFY_API_KEY=
VERIFY_WEBHOOK_SECRET=
VERIFY_BASE_URL=https://verify.et

# ---- Backups ----
AGE_RECIPIENT=age1

# ---- Storage ----
DB_PATH=./data/confess.db
